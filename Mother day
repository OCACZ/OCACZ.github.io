<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>母亲节祝福</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 50%, #ffd1ff 100%);
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .container {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      position: relative;
    }

    .gift-text {
      color: white;
      font-size: 20px;
      margin-bottom: 40px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
      animation: fadeInDown 1s ease;
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .envelope {
      position: relative;
      width: 280px;
      height: 200px;
      cursor: pointer;
      transform-style: preserve-3d;
      transition: transform 0.3s ease;
    }

    .envelope:hover {
      transform: scale(1.05);
    }

    .envelope-back {
      position: absolute;
      width: 100%;
      height: 100%;
      background: linear-gradient(145deg, #ff6b6b, #ee5a5a);
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .envelope-front {
      position: absolute;
      width: 100%;
      height: 100%;
      background: linear-gradient(145deg, #ff8787, #ff6b6b);
      border-radius: 10px;
      z-index: 2;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .heart {
      font-size: 60px;
      color: white;
      text-shadow: 0 0 10px rgba(255,255,255,0.5);
      animation: heartbeat 1.5s ease-in-out infinite;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    .envelope-flap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 80px;
      background: linear-gradient(180deg, #ff5252, #ff6b6b);
      clip-path: polygon(0 0, 50% 100%, 100% 0);
      z-index: 3;
      transform-origin: top center;
      transition: transform 0.6s ease;
    }

    .envelope.open .envelope-flap {
      transform: rotateX(180deg);
    }

    .letter {
      position: absolute;
      width: 90%;
      height: 80%;
      background: #fffef0;
      border-radius: 5px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0;
      transition: opacity 0.5s ease 0.3s;
      z-index: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .envelope.open .letter {
      opacity: 1;
    }

    .tap-hint {
      position: absolute;
      bottom: -60px;
      left: 50%;
      transform: translateX(-50%);
      color: white;
      font-size: 14px;
      text-align: center;
      animation: bounce 2s ease-in-out infinite;
      white-space: nowrap;
    }

    @keyframes bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(-10px); }
    }

    .content {
      display: none;
      text-align: center;
      color: white;
      padding: 40px 20px;
      animation: fadeIn 1s ease;
    }

    .content.show {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .title {
      font-size: 28px;
      margin-bottom: 20px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .subtitle {
      font-size: 20px;
      margin-bottom: 30px;
      opacity: 0.9;
    }

    .message {
      background: rgba(255,255,255,0.25);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 30px;
      margin: 20px auto;
      max-width: 320px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    }

    .message p {
      font-size: 18px;
      line-height: 2;
      margin: 10px 0;
    }

    .heart-big {
      font-size: 50px;
      color: #ff4d6d;
      text-shadow: 0 0 20px rgba(255,77,109,0.5);
      animation: pulse 2s ease-in-out infinite;
      margin: 20px 0;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.2); opacity: 0.8; }
    }

    .flower {
      position: fixed;
      font-size: 24px;
      animation: fall linear forwards;
      pointer-events: none;
      z-index: 100;
    }

    @keyframes fall {
      0% { transform: translateY(-100px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
    }

    .hidden {
      display: none !important;
    }

    .thanks-screen {
      display: none;
      text-align: center;
      color: white;
    }

    .thanks-screen.show {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 80vh;
      animation: fadeIn 1s ease;
    }

    .thanks-text {
      font-size: 32px;
      margin-bottom: 20px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
      animation: fadeIn 1s ease;
    }

    .thanks-sub {
      font-size: 18px;
      opacity: 0.9;
      margin-bottom: 30px;
      animation: fadeIn 1s ease 0.3s both;
    }

    .continue-btn {
      background: rgba(255,255,255,0.3);
      border: 2px solid white;
      color: white;
      padding: 15px 40px;
      border-radius: 30px;
      font-size: 16px;
      cursor: pointer;
      transition: all 0.3s ease;
      animation: fadeIn 1s ease 0.6s both;
    }

    .continue-btn:active {
      background: rgba(255,255,255,0.5);
      transform: scale(0.95);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="gift-text">您有一份祝福，打开看看</div>

    <div class="envelope" id="envelope" onclick="openEnvelope()">
      <div class="envelope-back"></div>
      <div class="letter">
        <span class="heart">💕</span>
      </div>
      <div class="envelope-front">
        <span class="heart">💌</span>
      </div>
      <div class="envelope-flap"></div>
    </div>
    <div class="tap-hint" id="tapHint">点击打开信封 💝</div>

    <div class="thanks-screen" id="thanksScreen">
      <div class="thanks-text">妈妈，您辛苦了！</div>
      <div class="thanks-sub">感谢您一路的陪伴与付出</div>
      <button class="continue-btn" onclick="showBlessing()">打开祝福</button>
    </div>

    <div class="content" id="blessingContent">
      <div class="title">❤️ 母亲节快乐 ❤️</div>
      <div class="heart-big">🌸</div>
      <div class="message">
        <p>🌹 平安喜乐</p>
        <p>🌟 万事顺心</p>
        <p>✨ 永远年轻</p>
        <p>💪 健康长寿</p>
      </div>
      <div class="subtitle">送给最爱的妈妈</div>
    </div>
  </div>

  <script>
    let hasOpened = false;
    let flowerInterval;

    function openEnvelope() {
      if (hasOpened) return;
      hasOpened = true;

      document.getElementById('envelope').classList.add('open');
      document.getElementById('tapHint').style.display = 'none';

      setTimeout(() => {
        document.getElementById('envelope').classList.add('hidden');
        document.getElementById('thanksScreen').classList.add('show');
        createFlowers();
      }, 800);
    }

    function showBlessing() {
      document.getElementById('thanksScreen').classList.remove('show');
      document.getElementById('thanksScreen').style.display = 'none';
      document.getElementById('blessingContent').classList.add('show');

      if (flowerInterval) {
        clearInterval(flowerInterval);
      }
      createFlowers();
    }

    function createFlowers() {
      const flowers = ['🌸', '💐', '🌹', '❤️', '💕', '🌺', '💗'];
      const container = document.body;

      function createFlower() {
        const flower = document.createElement('div');
        flower.className = 'flower';
        flower.textContent = flowers[Math.floor(Math.random() * flowers.length)];
        flower.style.left = Math.random() * 100 + 'vw';
        flower.style.animationDuration = (Math.random() * 3 + 4) + 's';
        flower.style.fontSize = (Math.random() * 15 + 15) + 'px';
        container.appendChild(flower);

        setTimeout(() => {
          flower.remove();
        }, 7000);
      }

      for (let i = 0; i < 10; i++) {
        setTimeout(createFlower, i * 200);
      }

      flowerInterval = setInterval(() => {
        createFlower();
      }, 500);
    }

    window.onload = function() {
      setTimeout(createFlowers, 1000);
    };

    document.addEventListener('touchmove', function(e) {
      if (e.touches.length > 1) {
        e.preventDefault();
      }
    }, { passive: false });
  </script>
</body>
</html>
